# PayPal sandbox credentials (create at https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# card (agent holds a card on file) or approval (payer approves in PayPal first)
PAYPAL_PAYMENT_MODE=card

# LLM (any OpenAI-compatible endpoint). Leave blank to run the deterministic planner.
# Gemini free tier: https://aistudio.google.com/apikey  (20 requests/day)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional second provider, used when the first is rate limited or down.
# Groq free tier: https://console.groq.com/keys  (14,400 requests/day)
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_API_KEY=
LLM2_MODEL=openai/gpt-oss-120b

# Local state
RESTOCK_DB=data/restock.db
